# "Entrar com Cognito" na tela de login. Colocar "true" junto com elas.
NEXT_PUBLIC_HAS_COGNITO="false"

NEXTAUTH_SECRET="5bf574c02d7e86cf369c83e41520f24750a076e250a6c31317488afdac03cd63"
NEXTAUTH_URL="http://localhost:3000"

# --- Fallback de login local (só usado se as vars do Cognito acima estiverem vazias) ---
