# Copie para .env e preencha.
#
# --- Banco (RFC 6.2/8: PostgreSQL) ---
# Dev local sem infra: deixe como está (SQLite em prisma/dev.db).
# Produção: string do Amazon RDS PostgreSQL, ex.
#   postgresql://usuario:senha@seu-rds.xxxxx.us-east-1.rds.amazonaws.com:5432/maruim
DATABASE_URL="file:./dev.db"

# --- Autenticação (RFC 6.2/9: Amazon Cognito) ---
# Preenchidos depois de criar o User Pool no Cognito (ver README.md, "Hospedagem").
# Enquanto vazios, o login em dev usa o fallback local (ver src/lib/auth.ts).
COGNITO_CLIENT_ID=""
COGNITO_CLIENT_SECRET=""
COGNITO_ISSUER=""
# Espelha as 3 vars acima só pra decidir, no cliente, se mostra o botão
# "Entrar com Cognito" na tela de login. Colocar "true" junto com elas.
NEXT_PUBLIC_HAS_COGNITO="false"

NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-em-produção"
NEXTAUTH_URL="http://localhost:3000"

# --- Fallback de login local (só usado se as vars do Cognito acima estiverem vazias) ---
OWNER_EMAIL="jaisson@maruim.com.br"
# Hash bcrypt da senha do dono. Gerar com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
# ⚠️ Escape todo "$" do hash como "\$" — o Next.js expande $VAR dentro do
# .env, e um hash bcrypt começa com $2a$10$..., que ele tenta interpretar
# como variável e corrompe. Ex.: "\$2a\$10\$abc..." (não "$2a$10$abc...").
OWNER_PASSWORD_HASH=""

# --- Armazenamento (RFC 6.2/9: Amazon S3) ---
# Preenchidos depois de criar o bucket. Enquanto vazios, upload de foto de
# produto fica desabilitado e o CRM aceita só uma URL de imagem colada.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# --- WhatsApp (RF02) ---
WHATSAPP_NUMBER="5547992401430"
