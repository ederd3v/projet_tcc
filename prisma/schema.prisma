//  ──────────────────────────────────────────────────────────────────────
//  📘 O QUE É: A ESTRUTURA do banco de dados — as 4 tabelas do RFC (seção 6.4).
//  ⚙️  COMO FUNCIONA: O Prisma lê este arquivo e gera (1) as migrações em SQL
//      (pasta migrations/) e (2) o código tipado para consultar o banco.
//  🎓 NA BANCA: Cliente 1—N Pedido, Pedido 1—N ItemPedido, ItemPedido N—1 Produto.
//      O mesmo schema vale para o banco de teste (este PC) e o de produção (AWS RDS).
//  ──────────────────────────────────────────────────────────────────────
// Modelo de dados conforme RFC seção 6.4 (TCC - CRM bebidas.md).
// 4 entidades: Cliente 1—N Pedido, Pedido 1—N ItemPedido, ItemPedido N—1 Produto.
//
// Provider: PostgreSQL em todo lugar — local (embedded-postgres ou Docker) e
// produção (Amazon RDS, RFC 6.2/8). As migrações em prisma/migrations/ são a
// fonte de verdade; produção só roda `prisma migrate deploy`.

generator client {
  provider      = "prisma-client-js"
  // native = máquina de dev; rhel-openssl-3.0.x = Linux do Amplify Hosting
  // (Amazon Linux 2023), onde roda o SSR em produção.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql" // RFC 6.2/8 — PostgreSQL portátil no teste, Amazon RDS em produção
  url      = env("DATABASE_URL")
}

// O status do pedido é texto (e não enum do banco): os valores válidos ficam em
// src/lib/status.ts (novo | confirmado | rota | entregue | cancelado) e são
// conferidos pela API antes de gravar (ver src/lib/regrasPedido.ts).

model Cliente {
  id       String   @id @default(cuid())
  nome     String
  telefone String
  email    String?
  // Bairro orienta a entrega em Joinville; notas guardam o que o dono anota
  // sobre o cliente (preferências, combinados). Ambos vêm do CRM.
  bairro   String?
  notas    String?
  criadoEm DateTime @default(now())
  pedidos  Pedido[]
}

model Produto {
  id        String       @id @default(cuid())
  nome      String
  descricao String
  preco     Float
  fotoUrl   String // S3 em produção; caminho em /products em dev/seed
  categoria String // "licor" | "kombucha" | "ice"
  volumeMl  Int
  ativo     Boolean      @default(true) // RF01: só ativo=true aparece na landing
  // Selo editorial mostrado no card de destaque da home ("Especial", "⭐ Top",
  // "Bestseller", "Clássico"). No site publicado era fixo no código; aqui vive
  // no banco para o dono poder mudar pelo CRM, como pede o RF07.
  selo      String?
  destaque  Boolean      @default(false) // aparece entre os 2 destaques da home
  // Estoque é controlado na tela de Produtos do CRM e recebe baixa quando um
  // pedido é registrado. Sem controle de reserva: é contagem simples.
  estoque   Int          @default(0)
  itens     ItemPedido[]
  criadoEm  DateTime     @default(now())
}

model Pedido {
  id         String       @id @default(cuid())
  // Opcional: um pedido nascido de um clique na landing não tem cliente
  // ainda — quem clicou é anônimo até conversar no WhatsApp. O dono associa
  // o cliente ao confirmar, e é isso que o RFC descreve (registro manual).
  cliente    Cliente?     @relation(fields: [clienteId], references: [id])
  clienteId  String?
  data       DateTime     @default(now())
  // "novo" | "confirmado" | "rota" | "entregue" | "cancelado" — os mesmos
  // identificadores do quadro do painel (src/lib/status.ts). Valor fora da
  // lista some do quadro sem erro, por isso a validação na API.
  status     String       @default("novo")
  // Origem alimenta o gráfico "De onde vêm os pedidos"; é o dado que liga a
  // landing ao CRM quando o pedido nasce de um clique no site.
  origem     String       @default("WhatsApp direto")
  // Pix, Dinheiro ou Cartão — só se sabe no fechamento, por isso opcional.
  pagamento  String?
  observacao String?
  total      Float
  itens      ItemPedido[]
}

model ItemPedido {
  id         String  @id @default(cuid())
  pedido     Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoId   String
  produto    Produto @relation(fields: [produtoId], references: [id])
  produtoId  String
  quantidade Int
  precoUnit  Float // preço no momento da venda (não muda se o produto mudar de preço depois)
}
